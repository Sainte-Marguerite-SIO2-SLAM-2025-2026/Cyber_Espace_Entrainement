<Window x:Class="Cyber_Espace_Entrainement.Views.Activite.InjectionSQLFacileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views.Activite"
        xmlns:vm="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Activite"
        Title="Injection SQL - Apprentissage et Test" 
        Height="1080" 
        Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:InjectionSQLViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#673AB7" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bouton Retour -->
                <Button Grid.Column="0"
                        Content="↩️   Retour"
                        Click="BackButton_Click"
                        Background="#383440"
                        Foreground="White"
                        Padding="15,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"/>

                <!-- Titre -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Injection SQL - Niveau Facile" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="Apprenez et testez vos connaissances en Injection SQL" 
                               FontSize="14" 
                               Foreground="#E1BEE7" 
                               Margin="0,5,0,0"/>
                </StackPanel>

            </Grid>
        </Border>


        <Border Grid.Row="1">
            <Grid/>
        </Border>
    </Grid>
</Window>
