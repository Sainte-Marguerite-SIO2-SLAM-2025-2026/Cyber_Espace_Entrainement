<Window x:Class="Cyber_Espace_Entrainement.Views.Activite.InjectionSQLFacileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views.Activite"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Activite"
        Title="Injection SQL - Niveau Facile"
        Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:InjectionSQLFacileViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <!-- ── Bouton principal violet ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"       Value="#673AB7"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Padding"          Value="22,11"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7E57C2"/>
                            </Trigger>
                            <Trigger Property="IsPressed"   Value="True">
                                <Setter Property="Background" Value="#512DA8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"   Value="False">
                                <Setter Property="Background" Value="#C5B3E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Bouton discret (retour) ── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#FFFFFF55"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox clair ── -->
        <Style x:Key="InputLight" TargetType="TextBox">
            <Setter Property="Background"     Value="White"/>
            <Setter Property="Foreground"     Value="#1A1A2E"/>
            <Setter Property="BorderBrush"    Value="#CCCCDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="12,10"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="CaretBrush"     Value="#673AB7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#673AB7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── PasswordBox clair ── -->
        <Style x:Key="PasswordLight" TargetType="PasswordBox">
            <Setter Property="Background"     Value="White"/>
            <Setter Property="Foreground"     Value="#1A1A2E"/>
            <Setter Property="BorderBrush"    Value="#CCCCDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="12,10"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#673AB7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Séparateur label ── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555577"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

    </Window.Resources>

    <!-- ════════════════════ ROOT ════════════════════ -->
    <Grid Background="#F4F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- body    -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Border Grid.Row="0" Background="#673AB7" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Retour -->
                <Button Grid.Column="0"
                        Content="← Retour"
                        Style="{StaticResource GhostBtn}"
                        Click="BackButton_Click"
                        VerticalAlignment="Center"/>

                <!-- Titre -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="Injection SQL — Niveau Facile"
                               FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Contournez l'authentification sans connaître le mot de passe"
                               FontSize="13" Foreground="#E1BEE7" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Bouton indice -->
                <Button Grid.Column="2"
                        Content="💡  Indice"
                        Style="{StaticResource GhostBtn}"
                        VerticalAlignment="Center"
                        Click="HintButton_Click"/>
            </Grid>
        </Border>

        <!-- ══════════════════ BODY ══════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>    <!-- formulaire  -->
                <ColumnDefinition Width="*"/>      <!-- requête SQL -->
            </Grid.ColumnDefinitions>

            <!-- ───── COLONNE GAUCHE : carte de connexion ───── -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          Background="#F4F4F8"
                          Padding="36,36,24,36">
                <StackPanel>

                    <!-- Objectif -->
                    <Border Background="White" CornerRadius="12"
                            Padding="20" Margin="0,0,0,20"
                           >
                        <Border.Effect>
                            <DropShadowEffect Color="#CCCCDD" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🎯  Objectif" FontSize="15" FontWeight="Bold"
                                       Foreground="#673AB7" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#444466"
                                       FontSize="13" LineHeight="21">
                                Le formulaire ci-dessous est connecté à un compte réel.
                                Votre login est affiché — il vous manque seulement le mot de passe.
                                Trouvez comment le contourner grâce à une injection SQL.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Carte login -->
                    <Border Background="White" CornerRadius="12" Padding="28,24">
                        <Border.Effect>
                            <DropShadowEffect Color="#CCCCDD" BlurRadius="14" ShadowDepth="3" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>

                            <!-- Icône app fictive -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,22">
                                <Border Background="#EDE7F6" Width="56" Height="56"
                                        CornerRadius="28" HorizontalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="26"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="BanqueApp" FontSize="16" FontWeight="Bold"
                                           Foreground="#1A1A2E" HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="Espace client sécurisé" FontSize="12"
                                           Foreground="#888899" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Login (pré-rempli, lecture seule) -->
                            <TextBlock Text="IDENTIFIANT" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#F0EEF8" CornerRadius="8"
                                    BorderBrush="#D0C8EE" BorderThickness="1"
                                    Padding="12,10" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤  " VerticalAlignment="Center" FontSize="14"/>
                                    <TextBlock Text="{Binding TargetLogin}"
                                               FontSize="14" FontFamily="Consolas"
                                               Foreground="#512DA8" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Mot de passe -->
                            <TextBlock Text="MOT DE PASSE" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource PasswordLight}"
                                         Margin="0,0,0,4"/>

                            <!-- Hint sous le champ -->
                            <TextBlock Text="Vous ne le connaissez pas — c'est normal."
                                       Foreground="#AAAACC" FontSize="11"
                                       FontStyle="Italic" Margin="0,0,0,20"/>

                            <!-- Bouton connexion -->
                            <Button Content="Se connecter"
                                    Command="{Binding LoginCommand}"
                                    CommandParameter="{Binding ElementName=PasswordBox}"
                                    Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Résultat -->
                    <Border Margin="0,20,0,0" CornerRadius="12" Padding="20"
                            Visibility="{Binding ResultVisibility}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"   Value="#F1FBF2"/>
                                <Setter Property="BorderBrush"  Value="#66BB6A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoginSuccess}" Value="False">
                                        <Setter Property="Background"  Value="#FFF5F5"/>
                                        <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding ResultIcon}"
                                       FontSize="30" HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ResultMessage}"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoginSuccess}" Value="False">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Infos utilisateur connecté -->
                            <StackPanel Visibility="{Binding UserInfoVisibility}" Margin="0,14,0,0">
                                <Separator Background="#B2DFDB" Margin="0,0,0,10"/>
                                <TextBlock FontSize="13" Foreground="#444466">
                                    <Run Text="👤  "/>
                                    <Run Text="{Binding ConnectedUser.Prenom}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding ConnectedUser.Nom}"/>
                                </TextBlock>
                                <TextBlock FontSize="13" Foreground="#444466" Margin="0,4,0,0">
                                    <Run Text="💰  Solde : "/>
                                    <Run Text="{Binding ConnectedUser.SoldeCompte}"/>
                                    <Run Text=" €"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ───── COLONNE DROITE : requête SQL en direct ───── -->
            <Grid Grid.Column="1" Background="#F4F4F8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bandeau requête SQL -->
                <Border Grid.Row="0" Background="White" Margin="24,36,36,0"
                        CornerRadius="12" Padding="24,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#CCCCDD" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚙️  Requête SQL générée — en direct"
                                       FontSize="15" FontWeight="Bold" Foreground="#673AB7"/>
                            <Border Background="#EDE7F6" CornerRadius="4"
                                    Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold"
                                           Foreground="#673AB7"/>
                            </Border>
                        </StackPanel>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="16">
                            <TextBox Text="{Binding SqlQuery, Mode=OneWay}"
                                     Background="Transparent"
                                     Foreground="#79C0FF"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     MinHeight="52"/>
                        </Border>
                        <TextBlock Text="La requête se reconstruit à chaque frappe dans le champ mot de passe."
                                   Foreground="#AAAACC" FontSize="11" FontStyle="Italic"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Zone vide volontaire — l'utilisateur doit explorer par lui-même -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Opacity="0.35">
                    <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Observez comment votre saisie modifie la requête."
                               Foreground="#888899" FontSize="14" HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="Cliquez sur « Indice » si vous êtes bloqué."
                               Foreground="#888899" FontSize="13" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ══════════════════ POPUP INDICE ══════════════════ -->
        <Grid x:Name="HintOverlay"
              Grid.RowSpan="2"
              Background="#88000000"
              Visibility="Collapsed">

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" CornerRadius="16" Padding="36,32"
                    Width="560">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>

                    <!-- En-tête popup -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="22" VerticalAlignment="Center"/>
                            <TextBlock Text="  Indices" FontSize="20" FontWeight="Bold"
                                       Foreground="#673AB7" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#888899" FontSize="18" Cursor="Hand"
                                Click="HintClose_Click"/>
                    </Grid>

                    <Separator Background="#EEEEEE" Margin="0,0,0,20"/>

                    <!-- Indice 1 -->
                    <Border Background="#F9F4FF" CornerRadius="8"
                            Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="① Le symbole commentaire"
                                       FontWeight="Bold" Foreground="#512DA8"
                                       FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#444466" FontSize="13" LineHeight="20">
                                En SQL,
                                <Run FontFamily="Consolas" Foreground="#7B1FA2" FontWeight="Bold"> -- </Run>
                                démarre un commentaire. Tout ce qui suit sur la même ligne est ignoré par le moteur.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Indice 2 -->
                    <Border Background="#F9F4FF" CornerRadius="8"
                            Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="② La condition toujours vraie"
                                       FontWeight="Bold" Foreground="#512DA8"
                                       FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#444466" FontSize="13" LineHeight="20">
                                <Run FontFamily="Consolas" Foreground="#7B1FA2" FontWeight="Bold">'1'='1'</Run>
                                est toujours vrai. Associé à un
                                <Run FontFamily="Consolas" Foreground="#7B1FA2" FontWeight="Bold">OR</Run>,
                                il rend la condition WHERE entière vraie, quelle que soit la valeur réelle du mot de passe.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Indice 3 (révélation progressive) -->
                    <Border Background="#FFF8E1" CornerRadius="8"
                            BorderBrush="#FFD54F" BorderThickness="1"
                            Padding="16,14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="③ Exemple de payload (à utiliser dans le champ mot de passe)"
                                       FontWeight="Bold" Foreground="#F57F17"
                                       FontSize="13" Margin="0,0,0,6"/>
                            <Border Background="#1E1E2E" CornerRadius="6" Padding="12">
                                <TextBlock FontFamily="Consolas" FontSize="13"
                                           Foreground="#FFD54F"
                                           Text="' OR '1'='1' --"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button Content="J'ai compris !"
                            Style="{StaticResource PrimaryBtn}"
                            HorizontalAlignment="Right"
                            Click="HintClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
