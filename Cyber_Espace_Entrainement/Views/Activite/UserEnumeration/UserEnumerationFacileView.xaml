<Window x:Class="Cyber_Espace_Entrainement.Views.Activite.UserEnumerationFacileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Activite"
        xmlns:converters="clr-namespace:Cyber_Espace_Entrainement.Converters"
        Title="UserEnumeration"
        Height="1080"
        Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Déclaration du converter -->
        <converters:ResultColorConverter x:Key="ResultColorConverter" />
    </Window.Resources>

    <Window.DataContext>
        <vm:UserEnumerationFacileViewModel />
    </Window.DataContext>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- EN-TÊTE -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#673AB7"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Bouton Retour -->
                <Button Grid.Column="0"
                        Content="↩️   Retour"
                        Click="BackButton_Click"
                        Background="#512DA8"
                        Foreground="White"
                        Padding="15,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0" />

                <!-- Titre -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Libelle}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock FontSize="14"
                               Foreground="#E1BEE7"
                               Margin="0,5,0,0">
                        <Run Text="Apprenez et testez vos connaissances en" />
                        <Run Text="{Binding Libelle}" />

                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    
                    <!-- Règles du jeu -->
                    <Border Background="White"
                            Padding="15"
                            CornerRadius="8"
                            Margin="0,0,20,0">

                        <Button Click="Regles_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <Image Source="/Resources/Images/regle_jeu.png"
                                   Stretch="Uniform"
                                   Width="56"
                                   Height="55" />
                        </Button>

                    </Border>

                    <!-- Score -->
                    <Border Background="White"
                            Padding="20,15"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="SCORE"
                                       FontSize="12"
                                       Foreground="#666"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />

                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold">
                <Run Text="{Binding Score}"
                                Foreground="#4CAF50" />
                <Run Text="/" />
                <Run Text="{Binding TotalPropositions}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================= -->
            <!-- ZONE MESSAGES (PLEINE LARGEUR) -->
            <!-- ============================= -->
            <Border Grid.Row="0"
                    Background="#F5F5F5"
                    Padding="35"
                    Margin="0,0,0,20"
                    CornerRadius="10">

                <StackPanel>
                    <TextBlock Text="Messages"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10" />
                    <!-- Messages de la bdd-->
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border 
                                        Padding="10"
                                        Margin="5"
                                        CornerRadius="5"
                                        MouseMove="Message_MouseMove">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource ResultColorConverter}">
                                            <Binding />
                                            <Binding Path="DataContext.EstValide"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Message}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============================= -->
            <!-- ZONES EN BAS (2 COLONNES) -->
            <!-- ============================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- USER ENUM -->
                <Border Grid.Column="0"
                        Background="Lavender"
                        AllowDrop="True"
                        Drop="UserEnum_Drop"
                        Padding="15"
                        Margin="0,0,10,0"
                        CornerRadius="10">

                    <StackPanel>
                        <TextBlock Text="User Enumeration"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding UserEnumeration}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border 
                                            Padding="10"
                                            Margin="5"
                                            CornerRadius="5"
                                            MouseMove="Message_MouseMove"
                                            MouseLeftButtonDown="Message_DoubleClick">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource ResultColorConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.EstValide"
                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Message}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- PAS USER ENUM -->
                <Border Grid.Column="1"
                        Background="PowderBlue"
                        AllowDrop="True"
                        Drop="PasUserEnum_Drop"
                        Padding="15"
                        Margin="10,0,0,0"
                        CornerRadius="10">

                    <StackPanel>
                        <TextBlock Text="Pas User Enumeration"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding PasUserEnumeration}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border 
                                            Padding="10"
                                            Margin="5"
                                            CornerRadius="5"
                                            MouseMove="Message_MouseMove"
                                            MouseLeftButtonDown="Message_DoubleClick">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource ResultColorConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.EstValide"
                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Message}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- bouton Valider/Recommencer -->
            <Button Grid.Row="2"
                    Content="{Binding TexteBouton}"
                    Style="{StaticResource ValiderButton}"
                    Margin="0,20,0,0"
                    Padding="15"
                    Command="{Binding ActionBoutonCommand}" />
            <TextBlock Grid.Row="3"
                       Text="{Binding MessageResultat}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="DarkBlue"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
     FOOTER
     ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="White"
                Padding="20"
                BorderBrush="#e0e0e0"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="© 2025 - Plateforme de Cybersécurité"
                           FontSize="12"
                           Foreground="#9E9E9E"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="Version 1.0"
                               FontSize="12"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />
                    <Button x:Name="BtnQuitter"
                            Content="❌ Quitter"
                            Style="{StaticResource QuitButton}"
                            Click="ButtonQuitter_Click"
                            MouseEnter="ButtonQuitter_MouseEnter"
                            MouseLeave="ButtonQuitter_MouseLeave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
