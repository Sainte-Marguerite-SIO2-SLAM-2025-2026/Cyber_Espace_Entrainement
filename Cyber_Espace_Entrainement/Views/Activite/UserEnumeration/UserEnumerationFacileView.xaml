<Window x:Class="Cyber_Espace_Entrainement.Views.Activite.UserEnumerationFacileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Activite"
        Title="UserEnumeration" Height="1080" Width="1920">

    <Window.DataContext>
        <vm:UserEnumerationFacileViewModel />
    </Window.DataContext>
   

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- EN-TÊTE -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#673AB7"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Bouton Retour -->
                <Button Grid.Column="0"
                        Content="↩️   Retour"
                        Click="BackButton_Click"
                        Background="#512DA8"
                        Foreground="White"
                        Padding="15,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0" />

                <!-- Titre -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Libelle}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Apprenez et testez vos connaissances en {Binding LibelleComplet}"
                    FontSize="14"
                               Foreground="#E1BEE7"
                               Margin="0,5,0,0" />
                </StackPanel>

                <!-- Score -->
                <Border Grid.Column="2"
                        Background="White"
                        Padding="20,15"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="SCORE"
                                   FontSize="12"
                                   Foreground="#666"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold">
                    <Run Text="{Binding Score}"
                            Foreground="#4CAF50" />
                    <Run Text="/"
                            Foreground="#666" />
                    <Run Text="{Binding TotalPropositions}"
                            Foreground="#666" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- Messages -->
                <RowDefinition Height="*" />
                <!-- Zones -->
            </Grid.RowDefinitions>

            <!-- ============================= -->
            <!-- ZONE MESSAGES (PLEINE LARGEUR) -->
            <!-- ============================= -->
            <Border Grid.Row="0"
                    Background="#F5F5F5"
                    Padding="35"
                    Margin="0,0,0,20"
                    CornerRadius="10">

                <StackPanel>
                    <TextBlock Text="Messages"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        Padding="10"
                                        Margin="5"
                                        CornerRadius="5"
                                        MouseMove="Message_MouseMove">
                                    <TextBlock Text="{Binding Message}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============================= -->
            <!-- ZONES EN BAS (2 COLONNES) -->
            <!-- ============================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- USER ENUM -->
                <Border Grid.Column="0"
                        Background="#E8F5E9"
                        AllowDrop="True"
                        Drop="UserEnum_Drop"
                        Padding="15"
                        Margin="0,0,10,0"
                        CornerRadius="10">

                    <StackPanel>
                        <TextBlock Text="User Enumeration"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding UserEnumeration}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            Padding="10"
                                            Margin="5"
                                            CornerRadius="5"
                                            MouseMove="Message_MouseMove"
                                            MouseLeftButtonDown="Message_DoubleClick">
                                        <TextBlock Text="{Binding Message}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- PAS USER ENUM -->
                <Border Grid.Column="1"
                        Background="#FFEBEE"
                        AllowDrop="True"
                        Drop="PasUserEnum_Drop"
                        Padding="15"
                        Margin="10,0,0,0"
                        CornerRadius="10">

                    <StackPanel>
                        <TextBlock Text="Pas User Enumeration"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding PasUserEnumeration}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            Padding="10"
                                            Margin="5"
                                            CornerRadius="5"
                                            MouseMove="Message_MouseMove"
                                            MouseLeftButtonDown="Message_DoubleClick">
                                        <TextBlock Text="{Binding Message}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</Window>
