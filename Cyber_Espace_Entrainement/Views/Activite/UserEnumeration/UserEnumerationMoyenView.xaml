<Window x:Class="Cyber_Espace_Entrainement.Views.Activite.UserEnumerationMoyenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Activite"
        xmlns:converters="clr-namespace:Cyber_Espace_Entrainement.Converters"
        Loaded="Window_Loaded"
        Title="UserEnumeration"
        Height="1080"
        Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:UserEnumerationMoyenViewModel />
    </Window.DataContext>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->
        <Border Grid.Row="0"
                Background="#673AB7"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Bouton Retour -->
                <Button Grid.Column="0"
                        Content="↩️   Retour"
                        Click="BackButton_Click"
                        Background="#512DA8"
                        Foreground="white"
                        Padding="15,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0" />

                <!-- Titre -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Libelle}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock FontSize="14"
                               Foreground="#E1BEE7"
                               Margin="0,5,0,0">
                        <Run Text="Apprenez et testez vos connaissances en" />
                        <Run Text="{Binding Libelle}" />
                    </TextBlock>
                </StackPanel>

                <!-- Score + Règles -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Background="White"
                            Padding="15"
                            CornerRadius="8"
                            Margin="0,0,20,0">
                        <Button Click="Regles_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Image Source="/Resources/Images/regle_jeu.png"
                                   Stretch="Uniform"
                                   Width="56"
                                   Height="55" />
                        </Button>
                    </Border>

                    <Border Background="White"
                            Padding="20,15"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="SCORE"
                                       FontSize="12"
                                       Foreground="#666"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />

                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold">
                                <Run Text="{Binding Score}"
                                     Foreground="#4CAF50" />
                                <Run Text="/" />
                                <Run Text="{Binding TotalPropositions}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <Grid Grid.Row="1"
              Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3 *" />
                <RowDefinition Height="*" />
                <RowDefinition Height="0.3 *" />
            </Grid.RowDefinitions>

            <!-- Enigme 1 -->
            <TextBlock Grid.Row="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="40">
                <Run Text="{Binding Niveau}" />
                <Run Text="{Binding NumNiveau}" />
                <Run Text="{Binding Separateur}" />
                <Run Text="{Binding LibelleAct}" />


            </TextBlock>

            <!-- Enigme 1 -->
            <TextBlock Grid.Row="0"
                      Text="Attention un email valide et/ou un mot de passe assez long sont attendus !"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       FontSize="40" />



            <!-- ═══════════════════════════════════════════════════ -->
            <!-- FORMULAIRE DE CONNEXION -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="LightGray"
                    CornerRadius="12"
                    Padding="40"
                    Margin="40"
                    Width="600"
                    MinWidth="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding JeuConnexion}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <TextBlock Text="Connexion"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#512DA8"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Adresse email"
                                   FontWeight="SemiBold"
                                   Foreground="#444" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40"
                                 Padding="10"
                                 Background="#EEE"
                                 BorderThickness="0"
                                 FontSize="14" />
                    </StackPanel>

                    <!-- Mot de passe -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Mot de passe"
                                   FontWeight="SemiBold"
                                   Foreground="#444" />
                        <PasswordBox x:Name="PasswordBox"
                                     Height="40"
                                     Padding="10"
                                     Background="#EEE"
                                     BorderThickness="0"
                                     FontSize="14"
                                     PasswordChanged="PasswordBox_PasswordChanged" />
                    </StackPanel>

                    <!-- Message -->
                    <TextBlock Text="{Binding MessageErreur}"
                               Foreground="BlueViolet"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"
                               Visibility="{Binding MessageErreur, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- Bouton -->
                    <Button Content="Se connecter"
                            Command="{Binding ValiderConnexionCommand}"
                            Height="45"
                            Background="#673AB7"
                            Foreground="Black"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand" />

                </StackPanel>
            </Border>


            <!-- ═══════════════════════════════════════════════════ -->
            <!-- FORMULAIRE DE CRÉATION DE COMPTE -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="LightGray"
                    CornerRadius="12"
                    Padding="40"
                    Margin="40"
                    Width="600"
                    MinWidth="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding JeuInscription}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <TextBlock Text="Créer un compte"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#512DA8"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Adresse email"
                                   FontWeight="SemiBold"
                                   Foreground="#444" />
                        <TextBox Height="40"
                                 Padding="10"
                                 Background="#EEE"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Mot de passe -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Mot de passe"
                                   FontWeight="SemiBold"
                                   Foreground="#444" />
                        <PasswordBox x:Name="PasswordBoxCreation"
                                     Height="40"
                                     Padding="10"
                                     Background="#EEE"
                                     BorderThickness="0"
                                     FontSize="14"
                                     PasswordChanged="PasswordBox_PasswordChanged" />
                    </StackPanel>

                    <!-- Confirmation -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Confirmer le mot de passe"
                                   FontWeight="SemiBold"
                                   Foreground="#444" />
                        <PasswordBox x:Name="PasswordBoxCreationConfirm"
                            Height="40"
                                     Padding="10"
                                     Background="#EEE"
                                     BorderThickness="0"
                                     FontSize="14"
                                     PasswordChanged="PasswordBoxConfirm_PasswordChanged" />
                    </StackPanel>

                    <TextBlock Text="{Binding MessageErreur}"
                               Foreground="BlueViolet"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"
                               Visibility="{Binding MessageErreur, Converter={StaticResource StringToVisibilityConverter}}" />

                    <Button Content="Créer le compte"
                            Height="45"
                            Background="#4CAF50"
                            Foreground="Black"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding ValiderConnexionCommand}" />

                </StackPanel>
            </Border>


            <!-- ═══════════════════════════════════════════════════ -->
            <!-- FORMULAIRE DE RÉINITIALISATION DE MOT DE PASSE -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="LightGray"
                    CornerRadius="12"
                    Padding="40"
                    Margin="40"
                    Width="600"
                    MinWidth="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding JeuChangementMdp}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <TextBlock Text="Réinitialiser le mot de passe"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#512DA8"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Adresse email"
                                   FontWeight="SemiBold"
                                   Foreground="#444" />
                        <TextBox Height="40"
                                 Padding="10"
                                 Background="#EEE"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Text="{Binding MessageErreur}"
                               Foreground="BlueViolet"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"
                               Visibility="{Binding MessageErreur, Converter={StaticResource StringToVisibilityConverter}}" />

                    <Button Content="Envoyer le lien"
                            Height="45"
                            Background="#2196F3"
                            Foreground="Black"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding ValiderConnexionCommand}" />

                </StackPanel>
            </Border>






            <!-- ********* QUESTION USER ENUMERATION ********* -->
            <StackPanel Grid.Row="2"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding JeuTermine}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Est-ce que le message de retour est de l'user enumeration ?"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#333"
                           TextAlignment="Center"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Oui"
                            Command="{Binding ReponseOuiCommand}"
                            IsEnabled="{Binding FormulaireValide}"
                            Width="120"
                            Height="45"
                            Background="#4CAF50"
                            Foreground="Black"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,20,0" />


                    <Button Content="Non"
                            Command="{Binding ReponseNonCommand}"
                            IsEnabled="{Binding FormulaireValide}"
                            Width="120"
                            Height="45"
                            Background="#F44336"
                            Foreground="Black"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand" />

                </StackPanel>
            </StackPanel>


            <StackPanel Grid.Row="2"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding JeuTermine}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="#4CAF50">
                <Run Text="Vous avez obtenu" />
                <Run Text="{Binding Score}" />
                <Run Text="points sur" />
                <Run Text="{Binding TotalPropositions}" />
                </TextBlock>

                <Button Content="Recommencer"
                        Command="{Binding RecommencerCommand}"
                        Click="Recommencer_Click"
                        Width="140"
                        Height="45"
                        Background="#F44336"
                        Foreground="Black"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand" />

            </StackPanel>




        </Grid>
        <!-- ═══════════════════════════════════════════════════════════
FOOTER
═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="White"
                Padding="20"
                BorderBrush="#e0e0e0"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="© 2025 - Plateforme de Cybersécurité"
                           FontSize="12"
                           Foreground="#9E9E9E"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="Version 1.0"
                               FontSize="12"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />
                    <Button x:Name="BtnQuitter"
                            Content="❌ Quitter"
                            Style="{StaticResource QuitButton}"
                            Click="ButtonQuitter_Click"
                            MouseEnter="ButtonQuitter_MouseEnter"
                            MouseLeave="ButtonQuitter_MouseLeave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
