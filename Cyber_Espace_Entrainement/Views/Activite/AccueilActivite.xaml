<Window x:Class="Cyber_Espace_Entrainement.Views.Activite.AccueilActivite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views.Activite"
        xmlns:vm="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Activite"
        mc:Ignorable="d"
        Title="AccueilActivite" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:AccueilTestViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE avec bouton retour -->
        <Border Grid.Row="0" Background="#055E02" Padding="30,40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <!-- BOUTON RETOUR (à gauche) -->
                <Button Grid.Column="0"
                        Content="↩️   Retour"
                        Click="BackButton_Click"
                        Background="#7A61A6"
                        Foreground="White"
                        Padding="15,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"

                        ToolTip="Retour au menu principal">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Violet"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Violet"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,800,0">

                    <TextBlock Text="ACCUEIL DES TESTS" 
                               FontSize="42" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Teste tes connaissances !" 
                               FontSize="18" 
                               Foreground="#E3F2FD"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BOUTON PROFIL -->
        <Button x:Name="Profile"
         Grid.Row="0"
         Width="124" 
         Height="124"
         VerticalAlignment="Center"
         HorizontalAlignment="Right"
         Margin="0,0,20,10"
         Padding="0"
         Background="Transparent"
         BorderBrush="#1565C0"
         Cursor="Hand"
         ToolTip="Mon Profil">
            <Image Source="/Resources/icon_user_120.png" 
            Stretch="UniformToFill"/>
        </Button>

        <!-- Génération des boutons pour chaque activité de la BDD -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Activites}" Margin="10,0,-10,74" Grid.RowSpan="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SelectActiviteCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Width="250"
                            Height="320"
                            Margin="10"
                            Cursor="Hand"
                            Background="White"
                            BorderThickness="2"
                            BorderBrush="Transparent"
                            Tag="#43A047"
                            MouseEnter="Card_MouseEnter"
                            MouseLeave="Card_MouseLeave">

                        <!-- STYLE directement dans Button -->

                        <Button.RenderTransform>
                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="0">

                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <!-- Image -->
                                        <Image Source="/Resources/Images/AccueilTest/test.png"
                                        Height="200"
                                        Stretch="Fill"
                                        Margin="5"
                                        ClipToBounds="True"/>

                                        <!-- Libelle -->
                                        <TextBlock Text="{Binding Libelle}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="10,10,10,5"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>

                                        <!-- Thème -->
                                        <TextBlock Text="{Binding Theme}"
                                           FontSize="14"
                                           Margin="10,0,10,10"
                                           TextWrapping="Wrap"
                                           Foreground="DarkGray"
                                           TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="BlueViolet"/>
                                        <Setter TargetName="border" Property="BorderThickness" Value="3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <!-- PIED DE PAGE -->

        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="© 2025 - Plateforme de Cybersécurité" 
                   FontSize="12" 
                   Foreground="#9E9E9E"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Version 1.0" 
                       FontSize="12"
                       Foreground="#9E9E9E"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
                    <Button x:Name="BtnDeco"
                            Content="🔓 Déconnexion"
                            Click="BtnDeco_Click"
                            Style="{StaticResource DeconnexionButton}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="btnQuitter"
                            Content="❌ Quitter"
                            Style="{StaticResource QuitButton}"
                            Click="QuitButton_Click"
                            Height="35"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
