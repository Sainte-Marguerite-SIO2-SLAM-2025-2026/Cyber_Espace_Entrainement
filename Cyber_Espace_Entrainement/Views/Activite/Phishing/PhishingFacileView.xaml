<Window x:Class="Cyber_Espace_Entrainement.Views.Activite.PhishingFacileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views.Activite"
        xmlns:vm="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Activite"
        Title="Phishing - Apprentissage et Test" 
        Height="1080" 
        Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:PhishingViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#673AB7" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bouton Retour -->
                <Button Grid.Column="0"
                        Content="↩️   Retour"
                        Click="BackButton_Click"
                        Background="#512DA8"
                        Foreground="White"
                        Padding="15,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"/>

                <!-- Titre -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="✉️ PHISHING" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="Apprenez et testez vos connaissances en Phishing" 
                               FontSize="14" 
                               Foreground="#E1BEE7" 
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Score -->
                <Border Grid.Column="2"
                        Background="White" 
                        Padding="20,15" 
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="SCORE" 
                                   FontSize="12" 
                                   Foreground="#666" 
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="Bold">
                            <Run Text="{Binding Score}" Foreground="#4CAF50"/>
                            <Run Text="/" Foreground="#666"/>
                            <Run Text="{Binding TotalQuestions}" Foreground="#666"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>


        <Border Grid.Row="1">
            <Grid>
                <StackPanel Margin="30" HorizontalAlignment="Center" Width="800">

                    <TextBlock Text="📧 Analyse ce mail" FontSize="22" FontWeight="Bold"/>

                    <Border Background="#F5F5F5" Padding="15" Margin="0,15">
                        <StackPanel>

                            <TextBlock Text="De :" FontWeight="Bold"/>
                            <TextBlock Text="{Binding MailActuel.Expediteur}"/>

                            <TextBlock Text="Objet :" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MailActuel.Objet}" FontStyle="Italic"/>

                            <Image Source="{Binding MailActuel.Image}" Height="200" Margin="0,10"/>

                            <TextBlock Text="{Binding MailActuel.Contenu}"
                                       TextWrapping="Wrap"
                                       Margin="0,10"/>

                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <Button Content="✔️ Légitime"
                                Command="{Binding LegitCommand}"
                                Width="150" Margin="10"/>

                        <Button Content="⚠️ Frauduleux"
                                Command="{Binding FraudCommand}"
                                Width="150" Margin="10"/>

                    </StackPanel>

                    <TextBlock Text="{Binding MessageResultat}"
                               FontSize="16"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Margin="10"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
