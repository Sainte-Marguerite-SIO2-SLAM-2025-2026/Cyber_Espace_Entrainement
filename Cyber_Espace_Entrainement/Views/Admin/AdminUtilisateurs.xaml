<!--
    AdminUtilisateursView.xaml
    Page dédiée à la gestion des Utilisateurs.
    DataContext : AdminUtilisateursViewModel

    Spécificités par rapport à AdminCoursView :
    - Formulaire statique (pas de champs dynamiques) pour un contrôle précis
    - Champs lecture seule : Id, DateCreation, DerniereConnexion
    - ComboBox pour Section et Role
    - Champ MotPasse géré en code-behind (PasswordBox ne supporte pas le binding direct)
    - Zone de statut/erreur MVVM-friendly en bas de page
-->
<Window x:Class="Cyber_Espace_Entrainement.Views.Admin.AdminUtilisateurs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Administration — Utilisateurs"
        Height="1080"
        Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- En-tête -->
            <RowDefinition Height="*" />
            <!-- Corps -->
            <RowDefinition Height="Auto" />
            <!-- Zone statut/erreur -->
        </Grid.RowDefinitions>

        <!-- ================================================================
             EN-TÊTE
        ================================================================ -->
        <Border Grid.Row="0"
                Background="#2196F3"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="↩️  Retour"
                        Click="BackButton_Click"
                        Padding="15,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1565C0" />
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0D47A1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GESTION DES UTILISATEURS"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Administration"
                               FontSize="14"
                               Foreground="#E3F2FD"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================
             CORPS — Formulaire statique + DataGrid
        ================================================================ -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <!-- Formulaire (un peu plus large pour les ComboBox) -->
                <ColumnDefinition Width="*" />
                <!-- DataGrid -->
            </Grid.ColumnDefinitions>

            <!-- ============================================================
                 COLONNE GAUCHE — Formulaire statique utilisateur
            ============================================================ -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#ddd"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Titre conditionnel selon le mode -->
                        <TextBlock FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="➕ Nouvel utilisateur" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="✏️ Modifier l'utilisateur" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- ID (lecture seule, toujours désactivé) -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="ID (auto)"
                                       FontWeight="Bold"
                                       Foreground="#999"
                                       Margin="0,0,0,5" />
                            <TextBox Text="{Binding IdAffiche}"
                                     IsEnabled="False"
                                     Background="#f5f5f5"
                                     Foreground="#999"
                                     Padding="8"
                                     FontSize="14" />
                        </StackPanel>

                        <!-- Login -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Login *"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5" />
                            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"
                                     FontSize="14" />
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Email *"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"
                                     FontSize="14" />
                        </StackPanel>

                        <!-- Nom -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Nom *"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5" />
                            <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"
                                     FontSize="14" />
                        </StackPanel>

                        <!-- Prénom -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Prénom *"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5" />
                            <TextBox Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"
                                     FontSize="14" />
                        </StackPanel>

                        <!-- Section (ComboBox) -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Section"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Sections}"
                                      SelectedItem="{Binding SectionSelectionnee}"
                                      Padding="8,6"
                                      FontSize="14" />
                        </StackPanel>

                        <!-- Rôle (ComboBox) -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Rôle *"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding RoleSelectionne}"
                                      Padding="8,6"
                                      FontSize="14" />
                        </StackPanel>

                        <!-- Mot de passe -->
                        <!--
                            PasswordBox utilisée pour masquer la saisie.
                            Le binding direct n'est pas possible en WPF (sécurité) :
                            le code-behind gère la synchronisation via l'événement FormCleared.
                            x:Name="PasswordBoxField" permet d'y accéder depuis le code-behind.
                        -->
                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Mot de passe"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5" />
                            <PasswordBox x:Name="PasswordBoxField"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         Padding="8"
                                         FontSize="14" />
                        </StackPanel>

                        <!-- Message d'aide mot de passe -->
                        <TextBlock Text="Laisser vide pour conserver le mot de passe actuel"
                                   FontSize="11"
                                   Foreground="#666"
                                   Margin="0,2,0,15">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- DateCreation (lecture seule) -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Date de création"
                                       FontWeight="Bold"
                                       Foreground="#999"
                                       Margin="0,0,0,5" />
                            <TextBox Text="{Binding DateCreationAffichee}"
                                     IsEnabled="False"
                                     Background="#f5f5f5"
                                     Foreground="#999"
                                     Padding="8"
                                     FontSize="14" />
                        </StackPanel>

                        <!-- DerniereConnexion (lecture seule) -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Dernière connexion"
                                       FontWeight="Bold"
                                       Foreground="#999"
                                       Margin="0,0,0,5" />
                            <TextBox Text="{Binding DerniereConnexionAffichee}"
                                     IsEnabled="False"
                                     Background="#f5f5f5"
                                     Foreground="#999"
                                     Padding="8"
                                     FontSize="14" />
                        </StackPanel>

                        <!-- Boutons Sauvegarder / Annuler -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Command="{Binding SaveLigneCommand}"
                                    Content="{Binding LibelleBoutonSauvegarder}"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    Padding="20,10"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,10,0" />

                            <Button Command="{Binding CancelEditCommand}"
                                    Background="#9E9E9E"
                                    Foreground="White"
                                    Padding="20,10"
                                    FontSize="14"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="🔄 Réinitialiser" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Content" Value="❌ Annuler" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================================================
                 COLONNE DROITE — Recherche + DataGrid
            ============================================================ -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#ddd"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Barre de recherche -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,15">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300"
                                 Padding="8"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="🔍 Rechercher"
                                Command="{Binding SearchCommand}"
                                Padding="15,8"
                                Background="#2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,5,0" />
                        <Button Content="↻ Réinitialiser"
                                Command="{Binding ResetFiltersCommand}"
                                Padding="10,8"
                                Background="#757575"
                                Foreground="White"
                                BorderThickness="0" />
                    </StackPanel>

                    <!-- DataGrid des utilisateurs -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Donnees}"
                              SelectedItem="{Binding LigneSelectionnee}"
                              AutoGenerateColumns="True"
                              AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              RowHeight="50"
                              AlternatingRowBackground="#f9f9f9">

                        <!-- Troncature et largeur max pour toutes les cellules -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="MaxWidth" Value="200" />
                                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}" />
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Colonne Actions (bouton Supprimer) -->
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Actions"
                                                    Width="120"
                                                    CanUserSort="False"
                                                    CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ Supprimer"
                                                Command="{Binding DataContext.DeleteLigneCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#f44336"
                                                Foreground="White"
                                                Padding="10,5"
                                                BorderThickness="0"
                                                Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================
             PIED DE PAGE — Zone de statut / erreur
             Masquée quand aucun message n'est présent (HasStatusMessage = false).
             Couleur pilotée par StatusColor (vert=succès, rouge=erreur).
        ================================================================ -->
        <Border Grid.Row="2"
                Background="{Binding StatusColor}"
                Padding="20,12"
                Margin="20,0,20,10"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

    </Grid>
</Window>
