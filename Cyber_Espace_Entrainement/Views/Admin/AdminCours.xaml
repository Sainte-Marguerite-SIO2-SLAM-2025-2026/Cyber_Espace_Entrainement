<!--
    AdminCoursView.xaml
    Page dédiée à la gestion des Cours.
    DataContext : AdminCoursViewModel
-->
<Window x:Class="Cyber_Espace_Entrainement.Views.Admin.AdminCours"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Administration — Cours"
        Height="1080"
        Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- En-tête -->
            <RowDefinition Height="*" />
            <!-- Corps -->
            <RowDefinition Height="Auto" />
            <!-- Zone statut -->
        </Grid.RowDefinitions>

        <!-- ================================================================
             EN-TÊTE
        ================================================================ -->
        <Border Grid.Row="0"
                Background="#2196F3"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="↩️  Retour"
                        Click="BackButton_Click"
                        Padding="15,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1565C0" />
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0D47A1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GESTION DES COURS"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Administration"
                               FontSize="14"
                               Foreground="#E3F2FD"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================
             CORPS — Formulaire + DataGrid
        ================================================================ -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <!-- Formulaire -->
                <ColumnDefinition Width="*" />
                <!-- DataGrid -->
            </Grid.ColumnDefinitions>

            <!-- ============================================================
                 COLONNE GAUCHE — Formulaire
            ============================================================ -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#ddd"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Titre conditionnel selon le mode -->
                        <TextBlock FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="➕ Nouveau cours" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="✏️ Modifier le cours" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Champs dynamiques (générés depuis les colonnes DataTable) -->
                        <ItemsControl ItemsSource="{Binding Champs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="{Binding Libelle}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Valeur, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8"
                                                 FontSize="14" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Message d'aide en mode édition -->
                        <TextBlock Text="(Laissez un champ vide pour ne pas le modifier)"
                                   FontSize="11"
                                   Foreground="#666"
                                   Margin="0,0,0,15">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Boutons Sauvegarder / Annuler -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Command="{Binding SaveLigneCommand}"
                                    Content="{Binding LibelleBoutonSauvegarder}"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    Padding="20,10"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,10,0" />

                            <Button Command="{Binding CancelEditCommand}"
                                    Background="#9E9E9E"
                                    Foreground="White"
                                    Padding="20,10"
                                    FontSize="14"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="🔄 Réinitialiser" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Content" Value="❌ Annuler" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================================================
                 COLONNE DROITE — Recherche + DataGrid
            ============================================================ -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#ddd"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Barre de recherche -->
                        <RowDefinition Height="*" />
                        <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Barre de recherche -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,15">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300"
                                 Padding="8"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="🔍 Rechercher"
                                Command="{Binding SearchCommand}"
                                Padding="15,8"
                                Background="#2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,5,0" />
                        <Button Content="↻ Réinitialiser"
                                Command="{Binding ResetFiltersCommand}"
                                Padding="10,8"
                                Background="#757575"
                                Foreground="White"
                                BorderThickness="0" />
                    </StackPanel>

                    <!--
                        DataGrid des cours.
                        AutoGenerateColumns="True" génère automatiquement les colonnes.
                        Les colonnes auto-générées ont une largeur maximale via le style ci-dessous.
                        Le texte tronqué avec "…" est géré par le CellStyle.
                    -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Donnees}"
                              SelectedItem="{Binding LigneSelectionnee}"
                              AutoGenerateColumns="True"
                              AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              RowHeight="50"
                              AlternatingRowBackground="#f9f9f9">

                        <!-- Style appliqué à toutes les cellules pour tronquer le texte long -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="MaxWidth" Value="220" />
                                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}" />
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Colonne Actions (bouton Supprimer) — ajoutée manuellement -->
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Actions"
                                                    Width="120"
                                                    CanUserSort="False"
                                                    CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ Supprimer"
                                                Command="{Binding DataContext.DeleteLigneCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#f44336"
                                                Foreground="White"
                                                Padding="10,5"
                                                BorderThickness="0"
                                                Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================
             PIED DE PAGE — Zone de statut / erreur
             Visible uniquement quand un message est présent (HasStatusMessage).
             Couleur de fond pilotée par StatusColor (vert=succès, rouge=erreur).
        ================================================================ -->
        <Border Grid.Row="2"
                Background="{Binding StatusColor}"
                Padding="20,12"
                Margin="20,0,20,10"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <!-- Affiche la zone uniquement si un message est présent -->
                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

    </Grid>
</Window>
