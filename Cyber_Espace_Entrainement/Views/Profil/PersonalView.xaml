<Window x:Class="Cyber_Espace_Entrainement.Views.Profil.PersonalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views.Profil"
        mc:Ignorable="d"
        Title="PersonalView" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- EN-TÊTE avec statistiques -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>
                <!-- BOUTON RETOUR (à gauche) -->
                <Button Grid.Column="0"
   Content="↩️   Retour"
   Click="BackButton_Click"
   Background="#1565C0"
   Foreground="White"
   Padding="15,10"
   FontSize="14"
   FontWeight="Bold"
   BorderThickness="0"
   Cursor="Hand"
   VerticalAlignment="Center"
   Margin="0,0,20,0"
   ToolTip="Retour au menu principal">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1565C0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0D47A1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GESTION DE VOS INFORMATIONS" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="White"/>
                    <TextBlock Text="Affichage de votre profil" 
                   FontSize="14" 
                   Foreground="#E3F2FD" 
                   Margin="0,5,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- COLONNE GAUCHE : Formulaire -->
            <Border Grid.Column="0" 
        Background="White" 
        BorderBrush="#ddd" 
        BorderThickness="1" 
        CornerRadius="8"
        Padding="20"
        Margin="0,0,5,0">

                <!-- Ajout du ScrollViewer (fix de ton bug) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="0" Background="White" Width="auto">
                        <TextBlock Text="Vos infos" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- Ligne 1 : Prénom + Nom -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Width="190">
                                <TextBlock Text="Prénom" FontWeight="SemiBold"/>
                                <TextBox x:Name="textBoxPrenom"/>
                            </StackPanel>
                            <StackPanel Width="190" Margin="20,0,0,0">
                                <TextBlock Text="Nom" FontWeight="SemiBold"/>
                                <TextBox x:Name="textBoxNom"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Ligne 2 : Pseudo + Mot de passe -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Width="190">
                                <TextBlock Text="Pseudo" FontWeight="SemiBold"/>
                                <TextBox x:Name="textBoxPseudo"/>
                            </StackPanel>
                            <StackPanel Width="190" Margin="20,0,0,0">
                                <TextBlock Text="Mot de passe" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="passwordBoxPassword"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Ligne 3 : Email -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Email" FontWeight="SemiBold"/>
                            <TextBox x:Name="textBoxEmail" />
                        </StackPanel>

                        <!-- Ligne 4 : Section -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Section" FontWeight="SemiBold"/>
                            <TextBox x:Name="textBoxSection"/>
                        </StackPanel>

                        <!-- Ligne 5 : Date création + Dernière co -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Width="190">
                                <TextBlock Text="Date création" FontWeight="SemiBold"/>
                                <TextBox x:Name="textBoxDateCreation"/>
                            </StackPanel>
                            <StackPanel Width="190" Margin="20,0,0,0">
                                <TextBlock Text="Dernière co" FontWeight="SemiBold"/>
                                <TextBox x:Name="textBoxDerniereConnection"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Ligne 6 : Score total -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Score total" FontWeight="SemiBold"/>
                            <TextBox x:Name="textBoxScoreTotal"/>
                        </StackPanel>

                        <!-- Boutons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveUserCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        Padding="20,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="➕ Créer"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Content" Value="💾 Enregistrer"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding CancelEditCommand}"
                        Background="#9E9E9E"
                        Foreground="White"
                        Padding="20,10"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="🔄 Réinitialiser"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Content" Value="❌ Annuler"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>



        <!--#region PIED DE PAGE -->
        <Border Grid.Row="2" 
        Background="White" 
        BorderBrush="#e0e0e0" 
        BorderThickness="0,1,0,0"
        Padding="20">
            <Grid>
                <TextBlock Text="© 2025 - Plateforme de Cybersécurité"
                   FontFamily="Verdana"
                   FontSize="12"
                   Foreground="#9E9E9E"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right">
                    <TextBlock Text="Version 1.0"
                       FontFamily="Verdana"
                       FontSize="12"
                       Foreground="#9E9E9E"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
                    <Button x:Name="btnQuitter"
                    Content="❌ Quitter"
                    Style="{StaticResource QuitButton}"
                    Command="{Binding QuitterCommand}"
                    Height="35"/>
                </StackPanel>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</Window>
