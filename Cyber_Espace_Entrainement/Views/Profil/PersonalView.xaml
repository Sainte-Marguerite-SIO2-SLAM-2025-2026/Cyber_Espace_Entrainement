<Window x:Class="Cyber_Espace_Entrainement.Views.Profil.PersonalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views.Profil"
        xmlns:vm="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Profil"
        mc:Ignorable="d"
        Title="PersonalView" Height="900" Width="1100"
        WindowStartupLocation="CenterScreen">


    <Window.DataContext>
        <vm:ProfilViewModel/>
    </Window.DataContext>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- EN-TÊTE avec statistiques -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>
                <!-- BOUTON RETOUR (à gauche) -->
                <Button Grid.Column="0"
   Content="↩️   Retour"
   Click="BackButton_Click"
   Background="#1565C0"
   Foreground="White"
   Padding="15,10"
   FontSize="14"
   FontWeight="Bold"
   BorderThickness="0"
   Cursor="Hand"
   VerticalAlignment="Center"
   Margin="0,0,20,0"
   ToolTip="Retour au menu principal">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1565C0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0D47A1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GESTION DE VOS INFORMATIONS" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="White"/>
                    <TextBlock Text="Affichage de votre profil" 
                   FontSize="14" 
                   Foreground="#E3F2FD" 
                   Margin="0,5,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                <!-- FORMULAIRE -->
                <Border Background="White" CornerRadius="10" Padding="25" BorderBrush="#D0D7DE" BorderThickness="1" Effect="{DynamicResource ShadowEffect}">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Vos Informations"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="✏️ Modifier les infos"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>  
                            </TextBlock>




                        <!-- Prénom + Nom -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <StackPanel Width="160">
                                    <TextBlock Text="Prénom" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource InputStyle}"
         IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>
                                
                                
                                <StackPanel Width="160" Margin="20,0,0,0">
                                    <TextBlock Text="Nom" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource InputStyle}"
         IsEnabled="{Binding IsEditMode}"/>

                            </StackPanel>
                            </StackPanel>
                            <!-- Pseudo + Mot de passe -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <StackPanel Width="160">
                                    <TextBlock Text="Pseudo" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Pseudo, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource InputStyle}"
         IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>
                                <StackPanel Width="160" Margin="20,0,0,0">
                                    <TextBlock Text="Mot de passe" FontWeight="SemiBold"/>
                                    <PasswordBox x:Name="passwordBoxPassword" Style="{StaticResource InputPasswordStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Email -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Email" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource InputStyle}"
         IsEnabled="{Binding IsEditMode}"/>
                        </StackPanel>
                            <!-- Section -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Section" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource InputStyle}"
         IsEnabled="{Binding IsEditMode}"/>
                        </StackPanel>
                            <!-- Dates -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <StackPanel Width="160">
                                    <TextBlock Text="Date de création" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding DateCreation, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource InputStyle}"
         IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>
                                <StackPanel Width="160" Margin="20,0,0,0">
                                    <TextBlock Text="Dernière connexion" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding DerniereConnection, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource InputStyle}"
         IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>
                            </StackPanel>
                            <!-- Score -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Score total" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding ScoreTotal, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource InputStyle}"
         IsEnabled="{Binding IsEditMode}"/>
                        </StackPanel>
                            <!-- Boutons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <Button Background="Blue"
                            Foreground="White"
Padding="15,10"
FontSize="14"
FontWeight="Bold"
BorderThickness="0"
Cursor="Hand"
Margin="0,0,10,0"
                            Content="✏️ Modifier" 
                                    Visibility="{Binding EditVisibilityModify}"
                                    Command="{Binding EditUserCommand}">
                                </Button>
                        <!-- Bouton Créer/Enregistrer -->
                        <Button Command="{Binding SaveUserCommand}"
    Background="#4CAF50"
    Foreground="White"
    Padding="15,10"
    FontSize="14"
    FontWeight="Bold"
    BorderThickness="0"
    Cursor="Hand"
    Margin="0,0,10,0"
                                Content="💾 Enregistrer"
                                Visibility="{Binding EditVisibilityGeneral}">
                            
                        </Button>
                        <Button  
    Command="{Binding CancelEditCommand}"
    Background="Red"
    Foreground="White"
    Padding="15,10"
    FontSize="14"
    BorderThickness="0"
    Cursor="Hand"
                            Content="❌ Annuler"
                            Visibility="{Binding EditVisibilityGeneral}">
                            
                        </Button>
                    </StackPanel>
                        </StackPanel>
                    
                </Border>
            </Grid>



            <!--#region PIED DE PAGE -->
        <Border Grid.Row="2" 
        Background="White" 
        BorderBrush="#e0e0e0" 
        BorderThickness="0,1,0,0"
        Padding="20">
            <Grid>
                <TextBlock Text="© 2025 - Plateforme de Cybersécurité"
                   FontFamily="Verdana"
                   FontSize="12"
                   Foreground="#9E9E9E"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right">
                    <TextBlock Text="Version 1.0"
                       FontFamily="Verdana"
                       FontSize="12"
                       Foreground="#9E9E9E"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
                    <Button x:Name="btnQuitter"
                    Content="❌ Quitter"
                    Style="{StaticResource QuitButton}"
                    Command="{Binding QuitterCommand}"
                    Height="35"/>
                </StackPanel>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</Window>
