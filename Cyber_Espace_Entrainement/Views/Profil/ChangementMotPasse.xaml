<Window x:Class="Cyber_Espace_Entrainement.Views.Profil.ChangementMotPasse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views.Profil"
        mc:Ignorable="d"
        Title="ChangementMotPasse" Height="650" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Style global pour les labels -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="0 15 0 5"/>
        </Style>

        <!-- Style global pour les PasswordBox -->
        <Style TargetType="PasswordBox" x:Key="PasswordStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>

        <!-- Style global pour les boutons -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 10 0 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Text="Changer votre mot de passe"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#2C3E50"
                   Margin="0 0 0 25"/>

        <!-- Contenu -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="40"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <StackPanel>

                <!-- Ancien mot de passe -->
                <TextBlock Text="Ancien mot de passe" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="OldPasswordBox"
                             Style="{StaticResource PasswordStyle}"
                             PasswordChanged="OldPasswordChanged"/>

                <!-- Nouveau mot de passe -->
                <TextBlock Text="Nouveau mot de passe" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="NewPasswordBox"
                             Style="{StaticResource PasswordStyle}"
                             PasswordChanged="NewPasswordChanged"/>

                <!-- Confirmation -->
                <TextBlock Text="Confirmer le nouveau mot de passe" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Style="{StaticResource PasswordStyle}"
                             PasswordChanged="ConfirmPasswordChanged"/>

                <!-- Message d'erreur -->
                <TextBlock Text="{Binding Message}"
                           Foreground="#E74C3C"
                           FontWeight="Bold"
                           Margin="0 10 0 0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Boutons -->
                <Button Content="Mettre à jour"
                        Command="{Binding ChangePasswordCommand}"
                        Style="{StaticResource PrimaryButton}"/>

                <Button Content="Retour"
                        Click="RetourButton_Click"
                        Style="{StaticResource PrimaryButton}"
                        Background="#7F8C8D"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>
