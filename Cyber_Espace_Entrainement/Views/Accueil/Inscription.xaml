<Window x:Class="Cyber_Espace_Entrainement.Views.Accueil.Inscription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views.Accueil"
        xmlns:viewmodels="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Accueil"        
        mc:Ignorable="d"
        Title="Inscription" 
        Height="550" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#f5f5f5"
        ResizeMode="NoResize">

    <Window.DataContext>
        <viewmodels:InscriptionViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Style pour les Labels -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Style pour les TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Focusable="false"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden"
                                        Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Grid.Column="2"
                                        Focusable="false"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                Content="{TemplateBinding Content}"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center"/>
                                                <Path Grid.Column="1"
                                                      x:Name="arrow"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#757575"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentPresenter"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            HorizontalAlignment="Left"
                                            IsHitTestVisible="false"
                                            Margin="10,0,30,0"
                                            VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="true"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="#BDBDBD"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MaxHeight="200">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="true"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les Buttons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour le bouton secondaire -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1565C0"/>
        </Style>

        <!-- Style pour le bouton quitter -->
        <Style x:Key="QuitButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f44336"/>
        </Style>

        <!-- Style pour les messages d'erreur -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#f44336"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->
        <Border Grid.Row="0" 
                Background="#1565C0" 
                Padding="20" 
                Margin="0,0,0,20">
            <TextBlock Text="Inscription"
                       FontFamily="Verdana"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- CONTENU -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="40,0">
            <Grid MaxWidth="800">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FORMULAIRE -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLONNE GAUCHE -->
                    <StackPanel Grid.Column="0">
                        <!-- Login -->
                        <Label Content="Login *"
                               Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="tbxLogin"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding LoginError}"
                                   Style="{StaticResource ErrorText}"
                                   Visibility="{Binding LoginError, Converter={StaticResource StringToVisibilityConverter}}"
                                   Margin="0,0,0,15"/>

                        <!-- Mot de passe -->
                        <Label Content="Mot de passe *"
                               Style="{StaticResource ModernLabel}"
                               Margin="0,10,0,5"/>
                        <PasswordBox x:Name="pbxMotDePasse"
                                     Height="38"
                                     FontFamily="Verdana"
                                     FontSize="14"
                                     Padding="10,8"
                                     Margin="0,0,0,5"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock Text="{Binding MotDePasseError}"
                                   Style="{StaticResource ErrorText}"
                                   Visibility="{Binding MotDePasseError, Converter={StaticResource StringToVisibilityConverter}}"
                                   Margin="0,0,0,15"/>

                        <!-- Nom -->
                        <Label Content="Nom *"
                               Style="{StaticResource ModernLabel}"
                               Margin="0,10,0,5"/>
                        <TextBox x:Name="tbxNom"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding NomError}"
                                   Style="{StaticResource ErrorText}"
                                   Visibility="{Binding NomError, Converter={StaticResource StringToVisibilityConverter}}"
                                   Margin="0,0,0,15"/>
                    </StackPanel>

                    <!-- COLONNE DROITE -->
                    <StackPanel Grid.Column="2">
                        <!-- Prénom -->
                        <Label Content="Prénom *"
                               Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="tbxPrenom"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding PrenomError}"
                                   Style="{StaticResource ErrorText}"
                                   Visibility="{Binding PrenomError, Converter={StaticResource StringToVisibilityConverter}}"
                                   Margin="0,0,0,15"/>

                        <!-- Section -->
                        <Label Content="Section *"
                               Style="{StaticResource ModernLabel}"
                               Margin="0,10,0,5"/>
                        <ComboBox x:Name="cbxSection"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Sections}"
                                  SelectedItem="{Binding SectionSelectionnee, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SectionError}"
                                   Style="{StaticResource ErrorText}"
                                   Visibility="{Binding SectionError, Converter={StaticResource StringToVisibilityConverter}}"
                                   Margin="0,0,0,15"/>

                        <!-- Mail -->
                        <Label Content="Email *"
                               Style="{StaticResource ModernLabel}"
                               Margin="0,10,0,5"/>
                        <TextBox x:Name="tbxMail"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding MailError}"
                                   Style="{StaticResource ErrorText}"
                                   Visibility="{Binding MailError, Converter={StaticResource StringToVisibilityConverter}}"
                                   Margin="0,0,0,15"/>
                    </StackPanel>
                </Grid>

                <!-- ZONE BOUTONS -->
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="btnValider"
                            Grid.Row="0"
                            Content="Valider l'inscription"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding ValiderCommand}"
                            Width="200"
                            Height="45"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" 
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Vous avez déjà un compte ?"
                                   FontFamily="Verdana"
                                   FontSize="13"
                                   Foreground="#757575"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button x:Name="btnConnexion"
                                Content="Connectez-vous"
                                Style="{StaticResource SecondaryButton}"
                                Height="35"
                                Click="Connexion_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- PIED DE PAGE -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#e0e0e0" 
                BorderThickness="0,1,0,0"
                Padding="20">
            <Grid>
                <TextBlock Text="© 2025 - Plateforme de Cybersécurité"
                           FontFamily="Verdana"
                           FontSize="12"
                           Foreground="#9E9E9E"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <TextBlock Text="Version 1.0"
                               FontFamily="Verdana"
                               FontSize="12"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button x:Name="btnQuitter"
                            Content="❌ Quitter"
                            Style="{StaticResource QuitButton}"
                            Command="{Binding QuitterCommand}"
                            Height="35"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>