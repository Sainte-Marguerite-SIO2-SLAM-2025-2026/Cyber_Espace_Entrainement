<Window x:Class="Cyber_Espace_Entrainement.Views.Accueil.ChoixNiveauWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choix du niveau" Height="400" Width="600">

    <ItemsControl ItemsSource="{Binding Activites}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Content="{Binding Niveau}"
                        Command="{Binding DataContext.SelectNiveauCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="10"
                        Height="50"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>