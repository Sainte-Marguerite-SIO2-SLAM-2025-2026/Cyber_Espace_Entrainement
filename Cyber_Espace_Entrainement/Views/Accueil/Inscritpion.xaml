<Window x:Class="Cyber_Espace_Entrainement.Views.Inscritpion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views"
        mc:Ignorable="d"
        Title="Inscritpion" 
        Height="450" 
        Width="800"
         WindowStartupLocation="CenterScreen"
         Background="#f5f5f5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!--#region EN TETE -->
        
        <Border Grid.Row="0" Background="#1565C0" Padding="0" Margin="0,0,0,10">
            <Label x:Name="lblTitre" 
                   Content="Inscription" 
                   Margin="0,0,0,0" 
                   Width="126" 
                   Foreground="White"
                   HorizontalContentAlignment="Center" 
                   VerticalContentAlignment="Center" 
                   FontFamily="Verdana" FontSize="20" 
                   HorizontalAlignment="Center"/>
        </Border>
        <!--#endregion-->
        
        <!--#region CONTENUE -->
        
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--#region CHAMP A REMPLIR -->
            
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    
                    <!--#region Login -->
                    <Label x:Name="lblLogin" 
                           Content="Login" 
                           Margin="0,10,0,0" 
                           VerticalAlignment="Top" 
                           Height="34" 
                           Width="264" 
                           VerticalContentAlignment="Center" 
                           FontFamily="Verdana" 
                           FontSize="20" 
                           HorizontalAlignment="center"/>
                    <TextBox x:Name="tbxLogin" 
                           Height="20" 
                           Margin="20,44,0,0" 
                           TextWrapping="Wrap" 
                           Text="TextBlock" 
                           VerticalAlignment="Top" 
                           Width="264" 
                           FontFamily="Verdana" 
                           FontSize="16" 
                           HorizontalAlignment="center"/>
                    <!--#endregion-->
                    
                    <!--#region Mot De Passe -->
                    <Label x:Name="lblMotDePasse" 
                           Content="Mot De Passe" 
                           Margin="0,69,0,0" 
                           VerticalAlignment="Top" 
                           Height="34" 
                           Width="264" 
                           VerticalContentAlignment="Center" 
                           FontFamily="Verdana" FontSize="20" 
                           HorizontalAlignment="center"/>
                    <TextBox x:Name="tbxMotDePasse" 
                           Height="20" 
                           TextWrapping="Wrap" 
                           Text="TextBlock" 
                           VerticalAlignment="Top" 
                           Width="264" 
                           FontFamily="Verdana" 
                           FontSize="16" 
                           Margin="20,105,0,0"
                           HorizontalAlignment="center"/>
                    <!--#endregion-->
                    
                    <!--#region Nom -->
                    <Label x:Name="lblNom" 
                           Content="Nom" 
                           Margin="0,135,0,0" 
                           VerticalAlignment="Top" 
                           Height="34"
                           Width="264" 
                           VerticalContentAlignment="Center" 
                           FontFamily="Verdana" 
                           FontSize="20" 
                           HorizontalAlignment="center"/>
                    <TextBox x:Name="tbxNom" 
                           Height="20" 
                           TextWrapping="Wrap" 
                           Text="TextBlock" 
                           VerticalAlignment="Top" 
                           Width="264" 
                           FontFamily="Verdana" 
                           FontSize="16" 
                           Margin="20,172,0,0"
                           HorizontalAlignment="center"/>
                    <!--#endregion-->
                    
                </Grid>

                <Grid Grid.Column="2">

                    <!--#region Prenom -->
                    <Label x:Name="lblPrenom" 
                           Content="Prenom" 
                           HorizontalAlignment="Center" 
                           Margin="0,10,0,0" 
                           VerticalAlignment="Top" 
                           Height="34" 
                           Width="264" 
                           VerticalContentAlignment="Center" 
                           FontFamily="Verdana" 
                           FontSize="20"/>
                    <TextBox x:Name="tbxPrenom" 
                           HorizontalAlignment="Center"
                           Height="20"
                           Margin="20,44,0,0"
                           TextWrapping="Wrap" 
                           Text="TextBlock" 
                           VerticalAlignment="Top" 
                           Width="264" 
                           FontFamily="Verdana" 
                           FontSize="16"/>
                    <!--#endregion-->

                    <!--#region Section -->
                    <Label x:Name="lblSection" 
                           Content="Section" 
                           HorizontalAlignment="Center"
                           Margin="0,69,0,0" 
                           VerticalAlignment="Top" 
                           Height="34" 
                           Width="264" 
                           VerticalContentAlignment="Center" 
                           FontFamily="Verdana" 
                           FontSize="20"/>
                    <TextBox x:Name="tbxSection" 
                           HorizontalAlignment="Center" 
                           Height="20" 
                           TextWrapping="Wrap" 
                           Text="TextBlock" 
                           VerticalAlignment="Top" 
                           Width="264" 
                           FontFamily="Verdana" 
                           FontSize="16" 
                           Margin="20,105,0,0" TextChanged="tbxSection_TextChanged"/>
                    <!--#endregion-->

                    <!--#region Mail -->
                    <Label x:Name="lblMail" 
                           Content="Mail" 
                           HorizontalAlignment="Center" 
                           Margin="0,135,0,0" 
                           VerticalAlignment="Top" 
                           Height="34" 
                           Width="264" 
                           VerticalContentAlignment="Center" 
                           FontFamily="Verdana" 
                           FontSize="20"/>
                    <TextBox x:Name="tbxMail" 
                           HorizontalAlignment="Center"
                           Height="20" 
                           TextWrapping="Wrap" 
                           Text="TextBlock" 
                           VerticalAlignment="Top" 
                           Width="264" 
                           FontFamily="Verdana" 
                           FontSize="16" 
                           Margin="20,172,0,0"/>
                    <!--#endregion-->

                </Grid>
            </Grid>
            <!--#endregion-->

            <!--#region ZONE BTN -->
            <Grid Grid.Row="1">
                <Button x:Name="btnValider" 
                       Content="Valider" 
                       HorizontalAlignment="Center" 
                       Height="37" Margin="0,10,0,0" 
                       VerticalAlignment="Top"
                       Width="162"/>
                <Label x:Name="lblConnexion"
                       Content="Vous avez déjà un compte ?" 
                       Margin="0,0,10,33" 
                       Width="181" 
                       HorizontalContentAlignment="Center" 
                       VerticalContentAlignment="Center" 
                       FontFamily="Verdana" 
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"/>
                <Button x:Name="btnConnexion" 
                       Content="Connectez-Vous" 
                       HorizontalAlignment="Right" 
                       Margin="0,0,10,0" 
                       VerticalAlignment="Bottom" 
                       Width="132" 
                       Height="33" 
                       FontSize="13"
                       Click="Connexion_Click"/>
            </Grid>
            <!--#endregion-->
            
        </Grid>
        <!--#endregion-->
        
        <!--#region PIEDS DE PAGE -->

        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="© 2025 - Plateforme de Cybersécurité" 
                   FontSize="12" 
                   Foreground="#9E9E9E"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Version 1.0" 
                       FontSize="12" 
                       Foreground="#9E9E9E"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
                    <Button Content="❌ Quitter" 
                    Click="QuitButton_Click"
                    Background="#f44336"
                    Foreground="White"
                    Padding="15,8"
                    BorderThickness="0"
                    Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
        <!--#endregion-->
        
    </Grid>
</Window>
