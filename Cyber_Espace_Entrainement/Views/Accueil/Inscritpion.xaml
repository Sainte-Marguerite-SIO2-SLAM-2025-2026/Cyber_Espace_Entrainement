<Window x:Class="Cyber_Espace_Entrainement.Views.Inscritpion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views"
        mc:Ignorable="d"
        Title="Inscritpion" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- EN TETE -->
        <Border Grid.Row="0" Background="#1565C0" Padding="30,40" Margin="0,0,0,10">
            <Label x:Name="lblTitre" Content="Inscription" Margin="0,24,0,376" Width="126" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20" HorizontalAlignment="Center"/>
        </Border>
        <!-- CHAMP A REMPLIR-->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Label x:Name="lblLogin" Content="Login" Margin="161,30,0,0" VerticalAlignment="Top" Height="34" Width="144" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20" HorizontalAlignment="Left"/>
            <Label x:Name="lblMotDePasse" Content="Mot De Passe" Margin="161,89,0,0" VerticalAlignment="Top" Height="34" Width="162" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20" HorizontalAlignment="Left"/>
            <Label x:Name="lblNom" Content="Nom" Margin="161,155,0,0" VerticalAlignment="Top" Height="34" Width="162" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20" HorizontalAlignment="Left"/>
            <Label x:Name="lblLogin_Copy" Content="Prenom" HorizontalAlignment="Left" Margin="492,30,0,0" VerticalAlignment="Top" Height="34" Width="144" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20"/>
            <Label x:Name="lblMotDePasse_Copy" Content="Section" HorizontalAlignment="Left" Margin="492,89,0,0" VerticalAlignment="Top" Height="34" Width="162" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20"/>
            <Label x:Name="lblNom_Copy" Content="Mail" HorizontalAlignment="Left" Margin="492,155,0,0" VerticalAlignment="Top" Height="34" Width="162" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20"/>
            <TextBox x:Name="tbxLogin" Height="20" Margin="181,64,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="264" FontFamily="Verdana" FontSize="16" HorizontalAlignment="Left"/>
            <TextBox x:Name="tbxSection" HorizontalAlignment="Left" Height="20" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="264" FontFamily="Verdana" FontSize="16" Margin="510,125,0,0"/>
            <TextBox x:Name="tbxPrenom" HorizontalAlignment="Left" Height="20" Margin="510,64,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="264" FontFamily="Verdana" FontSize="16"/>
            <TextBox x:Name="tbxMotDePasse" Height="20" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="264" FontFamily="Verdana" FontSize="16" Margin="181,125,0,0" HorizontalAlignment="Left"/>
            <TextBox x:Name="tbxNom" Height="20" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="264" FontFamily="Verdana" FontSize="16" Margin="181,192,0,0" HorizontalAlignment="Left"/>
            <TextBox x:Name="tbxMail" HorizontalAlignment="Left" Height="20" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="264" FontFamily="Verdana" FontSize="16" Margin="512,192,0,0"/>
            <Label x:Name="lblTitre_Copy" Content="Vous avez déjà un compte ?" Margin="595,343,0,57" Width="181" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Verdana" HorizontalAlignment="Left"/>
        </Grid>

        <!-- ZONE BTN -->

        <Button x:Name="btnValider" Content="Valider" HorizontalAlignment="Center" Height="37" Margin="0,335,0,0" VerticalAlignment="Top" Width="162"/>
        <Button x:Name="btnConnexion" Content="Connectez-Vous" HorizontalAlignment="Left" Margin="629,385,0,0" VerticalAlignment="Top" Width="132" Height="33" FontSize="13"/>

        <!-- PIEDS DE PAGE -->

        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="© 2025 - Plateforme de Cybersécurité" 
                   FontSize="12" 
                   Foreground="#9E9E9E"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Version 1.0" 
                       FontSize="12" 
                       Foreground="#9E9E9E"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
                    <Button Content="❌ Quitter" 
                    Click="QuitButton_Click"
                    Background="#f44336"
                    Foreground="White"
                    Padding="15,8"
                    BorderThickness="0"
                    Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
