<!-- Views/Commun/CustomMessageBox.xaml -->
<Window x:Class="Cyber_Espace_Entrainement.Views.Commun.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="450"
        MinHeight="150"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border x:Name="MainBorder"
            BorderBrush="#1565C0" 
            BorderThickness="2" 
            CornerRadius="8"
            Background="#f5f5f5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border x:Name="HeaderBorder"
                    Grid.Row="0" 
                    Background="#1565C0" 
                    CornerRadius="6,6,0,0"
                    Padding="20,15">
                <Grid>
                    <TextBlock Text="{Binding Title}" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               FontFamily="Verdana"
                               VerticalAlignment="Center"/>

                    <!-- Icône selon le type -->
                    <TextBlock x:Name="IconText"
                               FontSize="24"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"/>
                </Grid>
            </Border>

            <!-- Contenu du message -->
            <Grid Grid.Row="1" Margin="30,25" MinHeight="50">
                <TextBlock Text="{Binding Message}" 
                           TextWrapping="Wrap"
                           FontFamily="Verdana"
                           FontSize="14"
                           Foreground="#333333"
                           LineHeight="22"
                           VerticalAlignment="Center"
                           TextAlignment="Left"/>
            </Grid>

            <!-- Boutons -->
            <Border Grid.Row="2" 
                    Background="White" 
                    BorderBrush="#e0e0e0" 
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6"
                    Padding="20,15">
                <StackPanel x:Name="ButtonPanel"
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <!-- Les boutons seront ajoutés dynamiquement -->
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
