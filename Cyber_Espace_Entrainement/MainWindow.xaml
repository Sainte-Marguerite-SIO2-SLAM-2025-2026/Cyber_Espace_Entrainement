<Window x:Class="Cyber_Espace_Entrainement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cyber_Espace_Entrainement.Views.Accueil"
        mc:Ignorable="d"
        Title="Accueil" Height="450" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#f5f5f5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="lblTitre" Content="Connexion" HorizontalAlignment="Center" Margin="0,20,0,0" VerticalAlignment="Top" Height="34" Width="124" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20"/>
        <Button x:Name="btnValider" 
                Content="Valider" 
                HorizontalAlignment="Left" 
                Height="37" Margin="314,315,0,0" 
                VerticalAlignment="Top" Width="162"
                Click="Valider_Click"
                Background="#f44336"
                Foreground="White"
                Padding="15,8"
                BorderThickness="0"
                Cursor="Hand"/> 
        <Button x:Name="btnInscription" Content="Button" HorizontalAlignment="Left" Margin="645,378,0,0" VerticalAlignment="Top" Width="132" Height="33"/>
        <Label x:Name="lblLogin" Content="Login" HorizontalAlignment="Left" Margin="256,93,0,0" VerticalAlignment="Top" Height="34" Width="144" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20"/>
        <Label x:Name="lblMotDePasse" Content="Mot De Passe" HorizontalAlignment="Left" Margin="256,171,0,0" VerticalAlignment="Top" Height="34" Width="162" VerticalContentAlignment="Center" FontFamily="Verdana" FontSize="20"/>
        <TextBox x:Name="tbxMotDePasse" HorizontalAlignment="Center" Height="20" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Center" Width="264" FontFamily="Verdana" FontSize="16"/>
        <TextBox x:Name="tbxLogin" HorizontalAlignment="Center" Height="20" Margin="0,127,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="264" FontFamily="Verdana" FontSize="16"/>
    </Grid>
</Window>
