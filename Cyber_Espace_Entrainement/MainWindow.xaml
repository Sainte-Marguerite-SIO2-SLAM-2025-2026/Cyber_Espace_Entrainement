<Window x:Class="Cyber_Espace_Entrainement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Cyber_Espace_Entrainement.ViewModels.Accueil"
        Title="Connexion" 
        Width="650"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#f5f5f5"
        ResizeMode="NoResize">

    <Window.DataContext>
        <viewmodels:ConnexionViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="#1565C0" 
                Padding="20">
            <StackPanel>
                <TextBlock Text="CONNEXION" 
                           Foreground="White" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Plateforme de Cybersécurité" 
                           Foreground="#BBDEFB" 
                           FontSize="12" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="40,20">
            <StackPanel VerticalAlignment="Center">
                <Label Content="Identifiant" 
                       Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="tbxLogin" 
                         Style="{StaticResource ModernTextBox}" 
                         Tag="Nom d'utilisateur" 
                         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,5,0,15"/>

                <Label Content="Mot de passe" 
                       Style="{StaticResource ModernLabel}"/>
                <Grid Margin="0,5,0,20">
                    <!-- Password caché -->
                    <PasswordBox x:Name="pbxMotDePasse"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Tag="••••••••">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox"
                                   BasedOn="{StaticResource ModernPasswordBox}">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <!-- Password visible -->
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Padding="0,0,35,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox"
                                   BasedOn="{StaticResource InputStyle}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Icône œil -->
                    <Button Content="👁"
                            Width="48"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand" />
                    <!--Command="{Binding TogglePasswordVisibilityCommand}" />-->
                </Grid>
                
                <Button x:Name="btnConnecter" 
                        Content="SE CONNECTER" 
                        Style="{StaticResource ModernButton}" 
                        Command="{Binding ConnexionCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="40" 
                        Cursor="Arrow"
                        IsDefault="True"/>

                <Button Content="Pas encore de compte ? S'inscrire" 
                        Margin="0,15,0,0" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="#1565C0" 
                        Cursor="Hand" 
                        Click="BtnInscription_Click"/>
            </StackPanel>
        </Grid>

        <!--#region PIED DE PAGE -->
        <Border Grid.Row="2" 
                    Background="White" 
                    BorderBrush="#e0e0e0" 
                    BorderThickness="0,1,0,0"
                    Padding="20">
            <Grid>
                <TextBlock Text="© 2025 - Plateforme de Cybersécurité"
                           FontFamily="Verdana"
                           FontSize="12"
                           Foreground="#9E9E9E"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Right">
                    <TextBlock Text="Version 1.0"
                               FontFamily="Verdana"
                               FontSize="12"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button x:Name="btnQuitter"
                            Content="❌ Quitter"
                            Style="{StaticResource QuitButton}"
                            Command="{Binding QuitterCommand}"
                            Height="35"/>
                </StackPanel>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</Window>